+namespace MR {
+    template < class T >
+    struct eq_ptr_case {
+        eq_ptr_case(const char* pName) : mName(pName) {}
+        bool operator()(T pItem) const {
+            return MR::strcasecmp(pItem->getName(), mName) == 0;
+        }
+        const char* mName;
+    };
