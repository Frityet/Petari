+namespace MR {
+    namespace Effect {
+        bool createAndAddAutoEffectGroup(AutoEffectGroupHolder* pHolder, const char* pName) {
+            if (pHolder->isExist(pName)) {
+                return false;
+            }
+            AutoEffectGroup* pGroup = createAutoEffectGroup(pName);
+            if (pGroup == nullptr) {
+                return false;
+            }
+            pHolder->mGroups.push_back(pGroup);
+            return true;
+        }
