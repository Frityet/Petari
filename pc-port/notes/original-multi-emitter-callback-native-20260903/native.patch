+        emitter = pSystem->createEmitter(_4, mGroupId, 0);
+        mSpawn = emitter->isContinuousParticle() ? SINGLE_EMITTER_CONTINUOUS_SPAWN : SINGLE_EMITTER_ONE_TIME_SPAWN;
+        pSystem->forceDeleteEmitter(emitter);
+    }
