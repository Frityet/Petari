+    mDirSpeed = mpRes->getDyn()->getInitVelDir();
+    mSpread = mpRes->getDyn()->getInitVelDirSp();
+    mRndmDirSpeed = mpRes->getDyn()->getInitVelRndm();
+    mAirResist = mpRes->getDyn()->getAirRes();
