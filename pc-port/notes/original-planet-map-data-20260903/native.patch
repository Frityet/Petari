+            "MarblePlanetElectron",
+        },
+        {
+            "MarblePlanet",
+            "MarblePlanetElectronShadow",
+        },
+        {
+            "OceanRingPlanet",
+            "OceanRingPlanetLowInWater",
+        },
+        {
+            "WormEatenPlanet",
+            "GreenCaterpillarBigFace",
+        },
+        {
+            "WormEatenPlanet",
+            "GreenCaterpillarBigFaceLow",
+        },
+        {
+            "WormEatenPlanet",
+            "GreenCaterpillarBigBody",
+        },
+        {
+            "WormEatenPlanet",
+            "GreenCaterpillarBigBodyLow",
+        },
+        {
