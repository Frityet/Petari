+namespace {
+    static const UniqueEntry sUniquePlanetUniqueArchiveName[] = {
+        {
+            "BeamGoRoundPlanet",
+            "BeamGoRoundBeam",
+        },
+        {
+            "BeamGoRoundPlanet",
+            "BeamGoRoundBeamVolume",
+        },
+        {
