+    GXTexCoordID secTexCoordID = GX_TEXCOORD1;
+    if (ets->isUseIndirect()) {
+        GXSetTexCoordGen2(GX_TEXCOORD1, GX_TG_MTX2x4, GX_TG_TEX0, GX_IDENTITY, GX_FALSE, GX_PTIDENTITY);
