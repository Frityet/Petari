+            rInfo._60 = pInfo->_60;
+            rInfo.mHitPos = pInfo->mHitPos;
+            rInfo._70 = pInfo->_70;
+            rInfo._7C = pInfo->_7C;
+            rInfo._88 = pInfo->_88;
+            infos[index] = nullptr;
+        }
+        return mSortCount;
+    }
 
