+void StageDataHolder::calcDataAddress() {
+    _E4 = -1;
+    _E8 = 0;
+    updateDataAddress(&mPlacementObjs);
+    updateDataAddress(&mStartObjs);
+    updateDataAddress(&mGeneralPosObjs);
+    updateDataAddress(&mChildObjs);
+    updateDataAddress(&mPathObjs);
+}
