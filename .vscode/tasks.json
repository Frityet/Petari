{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PC showcase",
      "type": "shell",
      "command": "xmake",
      "args": [
        "build",
        "smg-pc-showcase"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "osx": {
        "command": "./script/build_and_run.sh",
        "args": [
          "--build-only"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
